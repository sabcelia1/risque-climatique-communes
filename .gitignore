# Données (trop volumineuses pour Git : elles se régénèrent avec src/ingest.py)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Identifiants cloud (ne jamais publier !)
secrets/
gha-creds-*.json
*.json.key
credentials*.json
service-account*.json
.env

# Power BI : on versionne le format .pbip, pas le .pbix ni le cache
*.pbix
**/.pbi/cache.abf
**/.pbi/localSettings.json

# Modèles entraînés (régénérés par src/modele.py)
/models/

# dbt
dbt/target/
dbt/logs/
dbt/.user.yml
logs/

# Système
.DS_Store
Thumbs.db
